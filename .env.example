# Optional. A public, CORS-enabled station snapshot produced by npm run snapshot.
STATION_SNAPSHOT_URL=
# Used only by the scheduled snapshot job; never exposed to the browser.
OPENAQ_API_KEY=
# Default launch region: Berlin region (west,south,east,north).
SNAPSHOT_BBOX=12.9,52.25,13.9,52.8
SNAPSHOT_REGION=Berlin region
# Source switches. The app remains functional with CAMS when stations are absent.
ENABLE_SENSOR_COMMUNITY=true
ENABLE_OPENAQ=true
